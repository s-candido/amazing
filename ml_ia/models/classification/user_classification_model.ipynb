   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# User Classification Model for Cluster Assignment\n",
    "\n",
    "This notebook creates a classification model to assign new users to existing clusters based on their behavior patterns.\n",
    "\n",
    "## Models Implemented:\n",
    "- XGBoost Classifier\n",
    "- LightGBM Classifier  \n",
    "- Neural Network (MLP)\n",
    "- Ensemble Model (Voting)\n",
    "\n",
    "## Features Used:\n",
    "- total_events: Total number of user interactions\n",
    "- total_views: Number of product views\n",
    "- total_purchases: Number of purchases\n",
    "- avg_time_between_events: Average time between user actions\n",
    "- total_spent: Total amount spent\n",
    "- avg_basket: Average basket size\n",
    "- conversion_rate: Purchase conversion rate\n",
    "- purchase_ratio: Purchase to view ratio\n",
    "- days_since_last_event: User activity recency\n",
    "- is_active: Active user flag (days_since_last_event < 30)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install required packages\n",
    "#%pip install xgboost lightgbm tensorflow scikit-learn pandas numpy matplotlib seaborn duckdb pathlib tqdm"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Data and Environment Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import duckdb\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "from typing import List, Dict, Tuple\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from tqdm import tqdm\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# ML Models\n",
    "from sklearn.model_selection import train_test_split, StratifiedKFold, cross_val_score, GridSearchCV\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.metrics import classification_report, confusion_matrix, accuracy_score, f1_score\n",
    "from sklearn.ensemble import VotingClassifier, RandomForestClassifier\n",
    "from sklearn.neural_network import MLPClassifier\n",
    "\n",
    "# Advanced models\n",
    "import xgboost as xgb\n",
    "import lightgbm as lgb\n",
    "\n",
    "# Set random seeds for reproducibility\n",
    "RANDOM_STATE = 42\n",
    "np.random.seed(RANDOM_STATE)\n",
    "\n",
    "print(\"Libraries imported successfully!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define database path\n",
    "DB_NAME = Path(\"../../amazing.duckdb\")\n",
    "\n",
    "# Connect to the database\n",
    "con = duckdb.connect(str(DB_NAME))\n",
    "print(f\"Connected to database at: {DB_NAME}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load events data (limit for better performance)\n",
    "try:\n",
    "    all_events = con.sql(\"\"\"\n",
    "        SELECT * \n",
    "        FROM all_events\n",
    "        ORDER BY RANDOM()\n",
    "        LIMIT 50000\n",
    "    \"\"\").to_df()\n",
    "    print(f\"Loaded {len(all_events)} events\")\n",
    "except:\n",
    "    print(\"all_events table not found. Creating sample data for demonstration...\")\n",
    "    # Create sample data for demonstration\n",
    "    all_events = create_sample_data()\n",
    "\n",
    "print(f\"Sample events shape: {all_events.shape}\")\n",
    "print(\"\\nEvent types distribution:\")\n",
    "print(all_events['event_type'].value_counts())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_sample_data():\n",
    "    \"\"\"Create sample data for demonstration when database is empty\"\"\"\n",
    "    print(\"Creating sample user data for demonstration...\")\n",
    "    \n",
    "    # Generate sample user features\n",
    "    n_users = 5000\n",
    "    np.random.seed(RANDOM_STATE)\n",
    "    \n",
    "    data = {\n",
    "        'user_id': range(1, n_users + 1),\n",
    "        'total_events': np.random.poisson(50, n_users),\n",
    "        'total_views': np.random.poisson(40, n_users),\n",
    "        'total_purchases': np.random.poisson(5, n_users),\n",
    "        'avg_time_between_events': np.random.exponential(100000, n_users),\n",
    "        'total_spent': np.random.exponential(500, n_users),\n",
    "        'avg_basket': np.random.exponential(100, n_users),\n",
    "        'conversion_rate': np.random.beta(2, 20, n_users),\n",
    "        'purchase_ratio': np.random.beta(1, 10, n_users),\n",
    "        'days_since_last_event': np.random.exponential(30, n_users),\n",
    "        'segment': np.random.choice(6, n_users)  # 6 clusters (0-5)\n",
    "    }\n",
    "    \n",
    "    df = pd.DataFrame(data)\n",
    "    \n",
    "    # Add derived features\n",
    "    df['is_active'] = (df['days_since_last_event'] < 30).astype(int)\n",
    "    \n",
    "    # Ensure logical consistency\n",
    "    df['total_purchases'] = np.minimum(df['total_purchases'], df['total_views'])\n",
    "    df['conversion_rate'] = np.minimum(df['conversion_rate'], 1.0)\n",
    "    df['purchase_ratio'] = np.minimum(df['purchase_ratio'], 1.0)\n",
    "    \n",
    "    return df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Data Preparation and Feature Engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load or create user segments data\n",
    "try:\n",
    "    # Try to load from user_segments_kmeans table\n",
    "    df = con.execute(\"SELECT * FROM user_segments_kmeans\").fetchdf()\n",
    "    print(f\"Loaded {len(df)} users from user_segments_kmeans\")\n",
    "except:\n",
    "    try:\n",
    "        # Try user_segments table\n",
    "        df = con.execute(\"SELECT * FROM user_segments\").fetchdf()\n",
    "        print(f\"Loaded {len(df)} users from user_segments\")\n",
    "    except:\n",
    "        print(\"No user segments table found. Creating sample data...\")\n",
    "        df = create_sample_data()\n",
    "\n",
    "# Feature engineering\n",
    "df[\"is_active\"] = (df[\"days_since_last_event\"] < 30).astype(int)\n",
    "\n",
    "# Add additional derived features\n",
    "df['events_per_day'] = df['total_events'] / np.maximum(df['days_since_last_event'], 1)\n",
    "df['spend_per_event'] = df['total_spent'] / np.maximum(df['total_events'], 1)\n",
    "df['view_to_purchase_ratio'] = df['total_views'] / np.maximum(df['total_purchases'], 1)\n",
    "\n",
    "print(f\"Final dataset shape: {df.shape}\")\n",
    "print(\"\\nColumns:\")\n",
    "print(df.columns.tolist())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check segment distribution\n",
    "print(\"Segment distribution:\")\n",
    "segment_counts = df['segment'].value_counts().sort_index()\n",
    "print(segment_counts)\n",
    "\n",
    "# Visualize segment distribution\n",
    "plt.figure(figsize=(10, 6))\n",
